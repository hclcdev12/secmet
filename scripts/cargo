#!/usr/bin/env bash
# Wrapper : cargo avec PATH rustup + contournement CIFS si besoin.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=env.sh
source "$SCRIPT_DIR/env.sh"
if ! command -v cargo >/dev/null 2>&1; then
    echo "ERROR: cargo introuvable. Lancez: make deps" >&2
    echo "  puis: source \"\$HOME/.cargo/env\"" >&2
    exit 127
fi
exec cargo "$@"
