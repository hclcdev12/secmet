#!/bin/sh
# Clé SecMet (Annexe N, §N.6) : au démarrage, installe la version de SecMet
# conservée sur la partition de données par le bouton « Installer la mise
# à jour » (app/<version>/), si elle est plus récente que celle de l'image
# et si ses signatures sont valides (clé de version). La précédente version
# reste comme repli ; en cas d'échec, l'image garde sa version.
#
# Lot ouvert (décision D14) : un lot de portée « machines » survit aux
# redémarrages. Une version V n'est déployée que si chaque lot ouvert de
# lots/ l'a été sous V (« "software": "secmet V" » dans son lot.json).
# Sinon V est reportée, avec un message au journal, et la version du lot
# est conservée : celle de l'image, ou une version plus ancienne du magasin
# qui est celle du lot. Un lot ouvert dont la version ne se lit pas compte
# comme ouvert sous une version inconnue : rien n'est déployé. La nouvelle
# version entre au premier démarrage qui suit la clôture du lot.
#
# Testable hors de la clé (packaging/live/tests/app-update.sh) : les deux
# dossiers se surchargent par SECMET_APP_UPDATE_DATA et SECMET_APP_UPDATE_RUN,
# les commandes système (mountpoint, dpkg-query, dpkg, secmet-release,
# dpkg-deb, logger) par le PATH.
DATA="${SECMET_APP_UPDATE_DATA:-/media/secmet-data}"
RUN="${SECMET_APP_UPDATE_RUN:-/run}"
STORE="$DATA/app"
LOTS="$DATA/lots"
# Clés de version acceptées (décision D7), une par ligne : même liste que
# RELEASE_PUBLIC_KEYS (src/update.rs, contrôlé par un test). Une signature
# par l'une d'elles suffit : la future clé s'ajoute ici avant d'être
# utilisée, l'ancienne se retire ensuite.
TRUST_KEYS="
bde3e3d9de271f8de9bb26c8dd4ed73f4c7344e309ebac7c3dffd50e02ca3bd5
"
mountpoint -q "$DATA" || exit 0
# Clé fabriquée sans app/ (racine root 0755) : l'opérateur ne pourrait pas
# le créer et « Installer la mise à jour » échouerait (EACCES).
if [ ! -d "$STORE" ]; then
    mkdir -p "$STORE" && chown 1000:1000 "$STORE" && chmod 700 "$STORE"
    exit 0
fi
installed=$(dpkg-query -W -f='${Version}' secmet 2>/dev/null | sed 's/~.*//')

# Lots ouverts, un par ligne : « <identifiant> <version> », version « ? »
# si elle ne se lit pas. lot.json est écrit par serde_json::to_string_pretty :
# champs du lot indentés de deux espaces, ceux des entrées machine davantage
# (format couvert par un test de src/lot.rs). Statut illisible : ouvert.
open_lots() {
    for f in "$LOTS"/*/lot.json; do
        [ -f "$f" ] || continue
        st=$(sed -n 's/^  "status": "\([a-z_]*\)",\{0,1\}$/\1/p' "$f" | head -1)
        case "$st" in closed|abandoned) continue ;; esac
        sw=$(sed -n 's/^  "software": "secmet \([^" ]*\)",\{0,1\}$/\1/p' "$f" | head -1)
        printf '%s %s\n' "$(basename "$(dirname "$f")")" "${sw:-?}"
    done
}
lots=$(open_lots)

# Arguments --trust de secmet-release, un par clé de version.
set --
for k in $TRUST_KEYS; do
    set -- "$@" --trust "$k"
done
# Du plus récent au plus ancien. Pas de clés « -k…n » avec un « -r » global :
# GNU sort n'applique pas l'option globale aux clés qui ont la leur, le tri
# restait ascendant et la clé redéployait la plus ancienne version (0.3.8
# devant 0.3.9, constaté le 2026-11-06).
for version in $(ls "$STORE" 2>/dev/null | sort -rV); do
    dir="$STORE/$version"
    [ -d "$dir" ] || continue
    deb=$(ls "$dir"/secmet_*.deb 2>/dev/null | head -1)
    [ -n "$deb" ] || continue
    if ! dpkg --compare-versions "$version" gt "$installed"; then
        logger -t secmet-app-update "version $version pas plus récente que $installed : rien à faire"
        exit 0
    fi
    # Un lot ouvert sous une autre version que $version : report. Les
    # versions plus anciennes du magasin restent candidates (celle du lot).
    blocker=$(printf '%s\n' "$lots" | awk -v v="$version" 'NF == 2 && $2 != v { print; exit }')
    if [ -n "$blocker" ]; then
        logger -t secmet-app-update "version $version reportée : lot ${blocker%% *} ouvert sous secmet ${blocker#* } ; déploiement au démarrage qui suivra sa clôture"
        continue
    fi
    tv=$(date +%s)
    if ! secmet-release verify "$dir" "$@" --file "$(basename "$deb")" >/dev/null 2>&1; then
        logger -t secmet-app-update "version $version : signature ou empreinte invalide, ignorée"
        continue
    fi
    logger -t secmet-app-update "version $version : signature et empreinte vérifiées ($(( $(date +%s) - tv )) s)"
    # Le paquet est déployé par dpkg-deb -x, sans passer par dpkg : la lecture
    # de sa base de données (64 000 entrées dans le squashfs) coûtait 17 à
    # 21 s avant la session sur un portable modeste (mesuré le 2026-11-05),
    # et les déclencheurs (man-db, caches d'icônes) près de 30 s de plus.
    # Le système est en mémoire et repart de l'image à chaque démarrage : la
    # base dpkg garde la version de l'image, sans conséquence ; le script
    # postinst du paquet ne fait que retirer des fichiers d'anciennes versions
    # absents de l'image. Diagnostic conservé sur la partition de données.
    LOG="$DATA/logs/system/app-update-$(tr -d - < /proc/sys/kernel/random/boot_id).log"
    t0=$(date +%s%N)
    {
        echo "$(date +%T) version $version : $deb"
        echo "$(date +%T) cpu : $(grep -m1 'cpu MHz' /proc/cpuinfo | tr -s ' ') ; gouverneur : $(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null) ; charge : $(cut -d' ' -f1-3 /proc/loadavg)"
        if [ -x /usr/bin/time ]; then
            /usr/bin/time -f "dpkg-deb -x : %e s réel, %U s utilisateur, %S s système" dpkg-deb -x "$deb" / 2>&1
        else
            dpkg-deb -x "$deb" / 2>&1
        fi && echo "$version" > "$RUN/secmet-app-update.version"
        echo "$(date +%T) fin"
    } > "$RUN/secmet-app-update.log" 2>&1
    mkdir -p "$DATA/logs/system" 2>/dev/null
    cp "$RUN/secmet-app-update.log" "$LOG" 2>/dev/null || true
    if [ -f "$RUN/secmet-app-update.version" ]; then
        logger -t secmet-app-update "SecMet $version déployée depuis la partition de données ($(( ($(date +%s%N) - t0) / 1000000 )) ms ; détail : $LOG)"
        exit 0
    fi
    logger -t secmet-app-update "version $version : installation échouée ($(tail -1 "$RUN/secmet-app-update.log")), repli"
done
exit 0
