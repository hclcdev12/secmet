#!/bin/sh
# Clé SecMet (Annexe N, §N.6) : au démarrage, installe la version de SecMet
# conservée sur la partition de données par le bouton « Installer la mise
# à jour » (app/<version>/), si elle est plus récente que celle de l'image
# et si ses signatures sont valides (clé de version). La précédente version
# reste comme repli ; en cas d'échec, l'image garde sa version.
DATA=/media/secmet-data
STORE="$DATA/app"
TRUST=bde3e3d9de271f8de9bb26c8dd4ed73f4c7344e309ebac7c3dffd50e02ca3bd5
mountpoint -q "$DATA" || exit 0
# Clé fabriquée sans app/ (racine root 0755) : l'opérateur ne pourrait pas
# le créer et « Installer la mise à jour » échouerait (EACCES).
if [ ! -d "$STORE" ]; then
    mkdir -p "$STORE" && chown 1000:1000 "$STORE" && chmod 700 "$STORE"
    exit 0
fi
installed=$(dpkg-query -W -f='${Version}' secmet 2>/dev/null | sed 's/~.*//')
for dir in $(ls -d "$STORE"/*/ 2>/dev/null | sed 's#/$##' | sort -t. -k1,1n -k2,2n -k3,3n -r); do
    version=$(basename "$dir")
    deb=$(ls "$dir"/secmet_*.deb 2>/dev/null | head -1)
    [ -n "$deb" ] || continue
    if ! dpkg --compare-versions "$version" gt "$installed"; then
        logger -t secmet-app-update "version $version pas plus récente que $installed : rien à faire"
        exit 0
    fi
    tv=$(date +%s)
    if ! secmet-release verify "$dir" --trust "$TRUST" --file "$(basename "$deb")" >/dev/null 2>&1; then
        logger -t secmet-app-update "version $version : signature ou empreinte invalide, ignorée"
        continue
    fi
    logger -t secmet-app-update "version $version : signature et empreinte vérifiées ($(( $(date +%s) - tv )) s)"
    # dpkg direct, sans déclencheurs : les dépendances sont celles de
    # l'image, et les déclencheurs (man-db, caches d'icônes et de menus)
    # coûtaient près de 30 s sur une clé lente avant la session, pour
    # un système en mémoire qui n'en a pas l'usage. Les déclencheurs en
    # attente ne gênent pas dpkg par la suite.
    # --force-unsafe-io : pas de fsync (système en mémoire) ; sans lui,
    # dpkg attendait la clé (18 s mesurés contre 0,5 s sur un banc).
    # Le paquet est déployé par dpkg-deb -x, sans passer par dpkg : la lecture
    # de sa base de données (64 000 entrées dans le squashfs) coûtait 17 à
    # 21 s avant la session sur un portable modeste (mesuré le 2026-11-05).
    # Le système est en mémoire et repart de l'image à chaque démarrage : la
    # base dpkg garde la version de l'image, sans conséquence ; le script
    # postinst du paquet ne fait que retirer des fichiers d'anciennes versions
    # absents de l'image. Diagnostic conservé sur la partition de données.
    LOG="$DATA/logs/system/app-update-$(tr -d - < /proc/sys/kernel/random/boot_id).log"
    t0=$(date +%s%N)
    {
        echo "$(date +%T) cpu : $(grep -m1 'cpu MHz' /proc/cpuinfo | tr -s ' ') ; gouverneur : $(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null) ; charge : $(cut -d' ' -f1-3 /proc/loadavg)"
        /usr/bin/time -f "dpkg-deb -x : %e s réel, %U s utilisateur, %S s système" dpkg-deb -x "$deb" / 2>&1 && echo "$version" > /run/secmet-app-update.version
        echo "$(date +%T) fin"
    } > /tmp/secmet-app-update.log 2>&1
    cp /tmp/secmet-app-update.log "$LOG" 2>/dev/null || true
    if [ -f /run/secmet-app-update.version ]; then
        logger -t secmet-app-update "SecMet $version déployée depuis la partition de données ($(( ($(date +%s%N) - t0) / 1000000 )) ms ; détail : $LOG)"
        exit 0
    fi
    logger -t secmet-app-update "version $version : installation échouée ($(tail -1 /tmp/secmet-app-update.log)), repli"
done
exit 0
