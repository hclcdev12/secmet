#!/bin/sh
# Clé SecMet écrite depuis l'image publiée (secmet-key_<version>_x86_64.img.xz,
# Etcher/Rufus/dd) : au premier démarrage,
#   1. la clé de signature des certificats est créée sur la partition de
#      données si elle manque (l'image publiée n'en contient pas : chaque
#      clé a la sienne, Annexe M §M.6) ; sa clé publique et son key_id vont
#      au journal (logs/system/) ;
#   2. la partition d'export (dernière) est agrandie jusqu'au bout de la
#      clé. Conditions : la table GPT se termine bien avant la fin du disque
#      (image plus petite que la clé) et la partition d'export est vide.
# Sinon, rien n'est touché. Idempotent (tourne à chaque démarrage).
set -u
DATA=/media/secmet-data
KEY="$DATA/config/attestation-key.hex"
if mountpoint -q "$DATA" && [ ! -f "$KEY" ] && command -v secmet-release >/dev/null 2>&1; then
    mkdir -p "$DATA/config"
    chown 1000:1000 "$DATA/config"
    chmod 700 "$DATA/config"
    # Même format que la clé créée par l'application au premier certificat
    # (fichier 0600) ; créée par root puis donnée à l'opérateur.
    if out=$(secmet-release keygen "$KEY" 2>&1); then
        chown 1000:1000 "$KEY" "${KEY%.hex}.pub"
        logger -t secmet-first-boot "clé de signature des certificats créée : $(printf '%s\n' "$out" | grep -E '^(public_key|key_id)' | tr -s ' ' | paste -sd ' ' -)"
    else
        logger -t secmet-first-boot "création de la clé de signature échouée : $out"
    fi
fi
EXP=$(blkid -L SECMET-EXP 2>/dev/null) || exit 0
[ -b "$EXP" ] || exit 0
DISK=$(lsblk -no PKNAME "$EXP" 2>/dev/null | head -1)
[ -n "$DISK" ] || exit 0
DISK="/dev/$DISK"
PARTNO=$(lsblk -no PARTN "$EXP" 2>/dev/null | head -1)
[ -n "$PARTNO" ] || exit 0
DISK_SECTORS=$(blockdev --getsz "$DISK")
END=$(sfdisk -l -o Device,End "$DISK" 2>/dev/null | awk -v d="$EXP" '$1==d {print $2}')
[ -n "$END" ] || exit 0
# Marge : moins de 64 Mio libres après l'export → rien à faire.
GAP=$((DISK_SECTORS - END))
[ "$GAP" -gt 131072 ] || exit 0
# Partition d'export non vide → on ne touche à rien.
MNT=$(mktemp -d)
if mount -o ro "$EXP" "$MNT" 2>/dev/null; then
    FILES=$(find "$MNT" -mindepth 1 -not -name 'System Volume Information' -not -path '*/System Volume Information/*' | head -1)
    umount "$MNT"
    rmdir "$MNT"
    [ -z "$FILES" ] || { logger -t secmet-first-boot "export non vide, pas d'agrandissement"; exit 0; }
else
    rmdir "$MNT"
fi
logger -t secmet-first-boot "agrandissement de la partition d'export ($EXP) : $((GAP / 2048)) Mio libres"
# En-tête GPT de secours replacé en fin de disque, puis partition étendue.
sfdisk -q --relocate gpt-bak-std "$DISK" 2>/dev/null || true
START=$(sfdisk -l -o Device,Start "$DISK" 2>/dev/null | awk -v d="$EXP" '$1==d {print $2}')
umount "$EXP" 2>/dev/null || true
printf '%s\n' "start=$START, size=+" | sfdisk -q --force -N "$PARTNO" "$DISK" >/dev/null 2>&1 \
    || { logger -t secmet-first-boot "sfdisk a échoué"; exit 0; }
partprobe "$DISK" 2>/dev/null; sleep 2
mkfs.exfat -q -L SECMET-EXP "$EXP" >/dev/null 2>&1 || { logger -t secmet-first-boot "mkfs.exfat a échoué"; exit 0; }
mount /media/secmet-export 2>/dev/null || true
logger -t secmet-first-boot "partition d'export agrandie : $(lsblk -no SIZE "$EXP")"
exit 0
