# Clé écrite depuis l'image publiée : au premier démarrage, crée la clé de
# signature des certificats et agrandit la partition d'export (voir
# /usr/local/bin/secmet-first-boot). Après le montage de la partition de
# données : la clé USB apparaît après local-fs.target (montage nofail,
# déclenché par udev), le service ne peut pas se contenter d'un After=.
[Unit]
Description=SecMet : premier demarrage (cle de signature, partition d'export)
After=media-secmet\x2ddata.mount
Requires=media-secmet\x2ddata.mount
Before=secmet-app-update.service lightdm.service
ConditionPathIsMountPoint=/media/secmet-data

[Service]
Type=oneshot
ExecStart=/usr/local/bin/secmet-first-boot

[Install]
WantedBy=multi-user.target
